<%
const aktif = (h) => path === h || (!['/pemilik', '/admin'].includes(h) && path.startsWith(h + '/'));
const namaPeran = { penghuni: 'Penghuni', pemilik: 'Pemilik', admin: 'Admin' }[user.role];
const samarkan = (e) => { const i = e.indexOf('@'); return i < 0 ? e : e.slice(0, Math.min(2, i)) + '***' + e.slice(i); };
const profil = navCfg.sidebar[0];
const pintasan = navCfg.sidebar.slice(1);
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>KasKost</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-ribbon"></div>
  <div class="bg-scrim"></div>

  <header class="app-header">
    <a class="logo" href="/" aria-label="The KasKost — beranda"><img src="/img/logo.png" alt="The KasKost" width="520" height="242"></a>
    <nav class="nav-pill" aria-label="Navigasi utama">
      <% navCfg.nav.forEach(function (n) { %>
      <a class="nav-link <%= aktif(n.href) ? 'aktif' : '' %>" href="<%= n.href %>"<%- aktif(n.href) ? ' aria-current="page"' : '' %>><%= n.label %></a>
      <% }) %>
    </nav>
    <details class="user-menu">
      <summary class="avatar-btn" aria-label="Menu akun"><%- include('../partials/icon', { nama: 'user' }) %></summary>
      <div class="menu glass-card">
        <div>
          <strong><%= user.nama_lengkap || user.email %></strong>
          <p class="text-secondary small"><%= namaPeran %></p>
        </div>
        <form method="post" action="/keluar">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn-secondary" type="submit">Keluar</button>
        </form>
      </div>
    </details>
  </header>

  <aside class="sidebar" aria-label="Pintasan">
    <a class="side-item side-profil <%= aktif(profil.href) ? 'aktif' : '' %>" href="<%= profil.href %>" id="profil-toggle" data-profil
       aria-label="<%= profil.label %>" title="<%= profil.label %>" aria-haspopup="true" aria-expanded="false" aria-controls="profil-pop">
      <% if (profil.huruf) { %><span class="huruf"><%= profil.huruf %></span><% } else { %><%- include('../partials/icon', { nama: profil.ikon }) %><% } %>
    </a>
    <% pintasan.forEach(function (s) { %>
    <a class="side-item <%= aktif(s.href) ? 'aktif' : '' %>" href="<%= s.href %>" aria-label="<%= s.label %>" title="<%= s.label %>">
      <% if (s.huruf) { %><span class="huruf"><%= s.huruf %></span><% } else { %><%- include('../partials/icon', { nama: s.ikon }) %><% } %>
      <% if (s.badge && notifBelumDibaca > 0) { %><span class="badge-count"><%= notifBelumDibaca > 9 ? '9+' : notifBelumDibaca %></span><% } %>
    </a>
    <% }) %>
  </aside>

  <!-- Popup profil: sidebar membesar menjadi kartu (dibuka dari ikon profil) -->
  <div class="profil-pop" id="profil-pop" role="dialog" aria-label="Profil dan pintasan" hidden>
    <div class="profil-avatar"><%- include('../partials/icon', { nama: 'user' }) %></div>
    <div class="profil-info">
      <strong><%= user.nama_lengkap || user.email %></strong>
      <span><%= user.role === 'penghuni' ? (kamarUser || 'Belum ada kamar') : namaPeran %></span>
      <span class="profil-email"><%= samarkan(user.email) %></span>
    </div>
    <hr class="divider">
    <nav class="profil-menu" aria-label="Pintasan akun">
      <% pintasan.forEach(function (s) { %>
      <a class="pop-item <%= aktif(s.href) ? 'aktif' : '' %>" href="<%= s.href %>">
        <span class="pop-ikon">
          <%- include('../partials/icon', { nama: s.ikon || 'user' }) %>
          <% if (s.badge && notifBelumDibaca > 0) { %><span class="badge-count"><%= notifBelumDibaca > 9 ? '9+' : notifBelumDibaca %></span><% } %>
        </span>
        <span><%= s.label %></span>
      </a>
      <% }) %>
    </nav>
  </div>

  <main class="app-main">
    <%- body %>
  </main>
  <script src="/js/app.js"></script>
  <script src="/js/transisi.js"></script>
</body>
</html>