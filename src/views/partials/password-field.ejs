<%
const adaError = (typeof pesanError !== 'undefined' && pesanError) || (typeof tandaiError !== 'undefined' && tandaiError);
%>
<div class="field">
  <label for="<%= id %>"><%= label %></label>
  <div class="input-wrap">
    <input class="input <%= adaError ? 'is-error' : '' %>" id="<%= id %>" type="password" name="<%= name %>" autocomplete="<%= autocomplete %>" required>
    <button type="button" class="toggle-pw" data-toggle-pw="<%= id %>" aria-pressed="false">Lihat</button>
  </div>
  <% if (typeof hint !== 'undefined' && hint) { %><p class="hint"><%= hint %></p><% } %>
  <% if (typeof pesanError !== 'undefined' && pesanError) { %><p class="error" role="alert"><%= pesanError %></p><% } %>
</div>