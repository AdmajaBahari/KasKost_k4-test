<h1 class="page-h1">Kos</h1>
<%- include('../../partials/tabs', { tabs: [
  { label: 'Persetujuan Pendaftar', href: '/pemilik/kos/pendaftar', aktif: true },
  { label: 'Kelola Penghuni', href: '/pemilik/kos/penghuni' },
  { label: 'Kelola Kamar', href: '/pemilik/kos/kamar' }
] }) %>

<% if (info === 'disetujui') { %><p class="notice alert-lebar">Pendaftar disetujui. Akunnya aktif dan kamar berstatus Terisi.</p><% } %>
<% if (info === 'ditolak') { %><p class="notice alert-lebar">Pendaftar ditolak dan sudah diberi tahu.</p><% } %>
<% if (info === 'gagal') { %>
<div class="alert alert-lebar" role="alert"><%- include('../../partials/icon', { nama: 'alert' }) %><strong>Gagal memproses. Pendaftar mungkin sudah diputuskan atau kamarnya sudah terisi.</strong></div>
<% } %>

<section class="glass-container">
  <h2>Persetujuan Pendaftar</h2>
  <% if (!daftar.length) { %>
  <p class="text-secondary">Tidak ada pendaftar yang menunggu persetujuan.</p>
  <% } else { %>
  <div class="tabel-scroll">
    <table class="tabel tabel-lebar">
      <thead><tr><th>Kamar</th><th>Email</th><th>Tanggal daftar</th><th>Aksi</th></tr></thead>
      <tbody>
        <% daftar.forEach(function (u) { %>
        <tr>
          <td><strong><%= u.kamar %></strong></td>
          <td><%= u.email %></td>
          <td><%= fmt.tanggalPendek(u.tanggal) %></td>
          <td>
            <div class="aksi-baris">
              <button class="btn-primary btn-kecil" type="button" data-dialog="dlg-setuju" data-aksi="/pemilik/kos/pendaftar/<%= u.id %>/setujui" data-ringkas="<%= u.kamar %> · <%= u.email %>">Setujui</button>
              <button class="btn-secondary btn-kecil" type="button" data-dialog="dlg-tolak" data-aksi="/pemilik/kos/pendaftar/<%= u.id %>/tolak" data-ringkas="<%= u.kamar %> · <%= u.email %>">Tolak</button>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<dialog class="modal" id="dlg-setuju" aria-labelledby="jdl-setuju">
  <div class="row"><h2 id="jdl-setuju">Setujui pendaftar ini?</h2><button type="button" class="btn-ikon" data-tutup aria-label="Tutup">&times;</button></div>
  <p><strong data-ringkas></strong></p>
  <div class="notice-box"><%- include('../../partials/icon', { nama: 'alert' }) %><div><strong>Akun akan aktif.</strong><p class="text-secondary">Kamar berstatus Terisi dan pendaftar menerima notifikasi.</p></div></div>
  <form method="post" action="#" class="aksi-baris">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="button" class="btn-secondary" data-tutup>Batal</button>
    <button type="submit" class="btn-primary">Ya, Setujui</button>
  </form>
</dialog>

<dialog class="modal" id="dlg-tolak" aria-labelledby="jdl-tolak">
  <div class="row"><h2 id="jdl-tolak">Tolak pendaftar ini?</h2><button type="button" class="btn-ikon" data-tutup aria-label="Tutup">&times;</button></div>
  <p><strong data-ringkas></strong></p>
  <form method="post" action="#" class="auth-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input class="input" type="text" name="alasan" maxlength="200" placeholder="Alasan penolakan (opsional)" aria-label="Alasan penolakan (opsional)">
    <div class="aksi-baris">
      <button type="button" class="btn-secondary" data-tutup>Batal</button>
      <button type="submit" class="btn-primary">Ya, Tolak</button>
    </div>
  </form>
</dialog>